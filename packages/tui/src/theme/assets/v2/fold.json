        "500": "#7bb8c4",
        "600": "#92c9d4",
        "700": "#a8dbe4",
        "800": "#bfecf4",
        "900": "#e3fafe"
      },
      "blue": {
        "100": "#202b52",
        "200": "#3e5db9",
        "300": "#344e9d",
        "400": "#3e5db9",
        "500": "#7a97e3",
        "600": "#c5d5f7",
        "700": "#dce6fc",
        "800": "#edf2ff",
        "900": "#edf2ff"
      },
      "purple": {
        "100": "#372b50",
