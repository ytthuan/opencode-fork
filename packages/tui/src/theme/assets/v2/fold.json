      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "border": {
      "base": "#3c4b65"
    },
    "scrollbar": {
      "base": "#5b6982"
    },
    "text": {
      "muted": "#a8b1c4"
    }
  }
}
